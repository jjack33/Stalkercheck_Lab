<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal device-admin policy declaration so the receiver is OS-recognized and
     can be activated in Settings. The receiver enforces nothing. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
